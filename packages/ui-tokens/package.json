{
  "name": "@compound/ui-tokens",
  "version": "0.1.2",
  "private": true,
  "type": "module",
  "description": "Saha design tokens v0.1.2 for apps/portal and apps/mobile. Consumed from source; no build step.",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": { "types": "./src/index.ts", "default": "./src/index.ts" },
    "./tokens.css": "./tokens.css",
    "./tokens.json": "./saha-ui-tokens-v0.1.2.json"
  },
  "files": ["src", "tokens.css", "saha-ui-tokens-v0.1.2.json"],
  "scripts": {
    "gen:css": "node --experimental-strip-types scripts/gen-css.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
