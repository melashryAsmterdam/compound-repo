{
  "name": "@compound/api",
  "version": "1.0.0",
  "private": true,
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && mkdir -p dist/infra/migrations && cp src/infra/migrations/*.sql dist/infra/migrations/",
    "typecheck": "tsc --noEmit --noUnusedLocals",
    "start": "node dist/main.js",
    "migrate": "node dist/migrate.js",
    "dev": "pnpm build && node dist/main.js",
    "worker": "WORKER=1 node dist/main.js",
    "seed": "node dist/seed.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@compound/domain": "workspace:*",
    "@compound/i18n": "workspace:*",
    "@compound/legal": "workspace:*",
    "@electric-sql/pglite": "^0.5.14",
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/platform-express": "^11.1.0",
    "@node-rs/argon2": "^2.0.2",
    "cookie-parser": "^1.4.7",
    "express": "^5.2.1",
    "jose": "^5.10.0",
    "pg": "^8.16.0",
    "pino": "^10.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "^0.34.0",
    "yaml": "^2.8.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@swc/core": "^1.13.0",
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.15.0",
    "@types/supertest": "^6.0.3",
    "supertest": "^7.1.0",
    "typescript": "~5.9.3",
    "unplugin-swc": "^1.5.0",
    "vitest": "^4.1.12"
  }
}