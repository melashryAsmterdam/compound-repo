{
  "expo": {
    "name": "Compound",
    "slug": "compound-app",
    "scheme": "compoundapp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "sa.compound.app",
      "supportsTablet": false,
      "associatedDomains": ["applinks:go.compound.example.sa"],
      "infoPlist": {
        "NSCameraUsageDescription": "Take photos of a problem to attach to your maintenance request.",
        "NSPhotoLibraryUsageDescription": "Choose photos of a problem to attach to your maintenance request.",
        "NSFaceIDUsageDescription": "Unlock the app with Face ID.",
        "CFBundleAllowMixedLocalizations": true
      }
    },
    "android": {
      "package": "sa.compound.app",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [{ "scheme": "https", "host": "go.compound.example.sa", "pathPrefix": "/a/" }],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "plugins": [
      "expo-router",
      "expo-splash-screen",
      "expo-secure-store",
      ["expo-localization", { "supportsRTL": true }],
      "expo-font",
      ["expo-notifications", { "color": "#0F5E59" }],
      ["expo-image-picker", {
        "cameraPermission": "Take photos of a problem to attach to your maintenance request.",
        "photosPermission": "Choose photos of a problem to attach to your maintenance request."
      }],
      ["expo-local-authentication", { "faceIDPermission": "Unlock the app with Face ID." }]
    ],
    "experiments": { "typedRoutes": false },
    "extra": { "minSupportedVersion": "1.0.0" }
  }
}
