# Copy to .env.local for local runs. On Vercel set these in Project → Settings → Environment Variables.
# Required on Vercel: base URL of the shared API (no trailing slash). Browser calls to /api/* are proxied here.
API_URL=http://localhost:4000
# Optional: store links on the activation page (W-01).
APP_STORE_URL=
PLAY_STORE_URL=
